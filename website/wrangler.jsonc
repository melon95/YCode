{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ycode-website",
  "compatibility_date": "2026-09-27",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/*.mp4"]
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ycode.agentscience.com.cn",
      "custom_domain": true
    }
  ]
}
