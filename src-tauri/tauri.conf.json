{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "YCode",
  "version": "0.1.2",
  "identifier": "dev.ycode.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && cargo build --release -p ycode-notify && mkdir -p src-tauri/binaries && cp target/release/ycode-notify src-tauri/binaries/ycode-notify"
  },
  "app": {
    "windows": [
      {
        "title": "YCode",
        "width": 1100,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "binaries/ycode-notify": "binaries/ycode-notify"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ycode"]
      }
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzQ0UxOUQzNjkzQURGMDcKUldRSDN6cHAweG5Pc3pleG5IMDl3QVJoUzNTMW5zQXhxREpOYThmcFdRdE5RbG9FYnFJUklWeDQK",
      "endpoints": [
        "https://github.com/melon95/YCode/releases/latest/download/latest.json"
      ]
    }
  }
}
