{
  "name": "ycode-updater-worker",
  "private": true,
  "description": "Cloudflare Worker: ycode update endpoint + anonymous active-user counter",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute ycode-analytics --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute ycode-analytics --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.95.0"
  }
}
